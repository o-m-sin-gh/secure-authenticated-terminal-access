PORT=8080
ADMIN_PORT=9090

# Generate separate random secrets of at least 32 characters.
TERMINAL_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_KEY=replace-with-a-different-random-secret-at-least-32-characters

SESSION_TTL_SECONDS=3600
LAUNCH_TTL_SECONDS=60
MAX_ACTIVE_SESSIONS=10

TERMINAL_IMAGE=tsl0922/ttyd:1.7.7
TERMINAL_NETWORK=secureauthenticatedterminalaccess_terminal-internal
TERMINAL_COMMAND=ttyd -W --max-clients 1 bash

AUDIT_LOG_PATH=logs/terminal-access.jsonl
DOCKER_SOCKET=/var/run/docker.sock

ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
FRAME_ANCESTORS='self'
TTYD_HOST=127.0.0.1
TTYD_PORT=7681
